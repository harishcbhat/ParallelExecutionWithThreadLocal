<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
    Serial execution suite.

    No parallel="..." attribute (and no thread-count), so TestNG runs every
    @Test sequentially on a single thread. The ThreadLocal driver still works
    exactly the same - there is simply one thread, so one driver at a time.

    Run it with:  mvn test -DsuiteXmlFile=testng-serial.xml
-->
<suite name="SerialSuite" verbose="1">

    <parameter name="browser" value="chrome"/>
    <parameter name="headless" value="true"/>

    <test name="LoginTests">
        <classes>
            <class name="com.harishcbhat.selenium.tests.LoginTest"/>
        </classes>
    </test>

</suite>
